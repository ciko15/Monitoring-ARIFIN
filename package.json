    "bcryptjs": "^3.0.3",
    "dotenv": "^16.3.1",
    "elysia": "^1.4.28",
    "ems-airnav-package": "git+http://172.20.16.115:5500/DEV-INHOUSE-AIRNAV/EMS-AIRNAV-PACKAGE.git",
    "node-cron": "^4.2.1",
    "pg": "^8.18.0",
    "ping": "^1.0.0",
    "snmp": "^0.0.3",
    "snmp-native": "^1.2.0",
    "socket.io": "^4.8.3",
    "systeminformation": "^5.31.4"
  }
}
